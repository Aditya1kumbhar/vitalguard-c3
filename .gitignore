# ==========================================
# VitalGuard C3 — .gitignore
# ==========================================

# --- Sensitive Environment & Secrets ---
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert
*.crt
secrets/

# --- Large Installers & Binary Assets ---
*.exe
*.msix
*.msi
*.dmg
*.pkg
*.zip
*.tar.gz
*.iso
*.bin

# --- Node & Next.js Build Artifacts ---
node_modules/
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts.bak

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Python & Virtual Environments ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Local Databases & Data Stores ---
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
alerts.db
backend/alerts.db

# --- IDE, Editor & OS Artifacts ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Internal Agent / Workspace Metadata ---
.kilo/
.system_generated/
scratch/
